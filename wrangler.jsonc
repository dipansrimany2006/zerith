{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zerith",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // These paths reach the Worker code; everything else is served straight from dist/.
    "run_worker_first": ["/api/*", "/rpc"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAYER", "class_name": "Relayer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relayer"] }],
  "vars": {
    // 5042002 is Arc Testnet, 5042 is Arc mainnet. Must match VITE_CHAIN_ID in the .env the app is built with.
    "CHAIN_ID": "5042002",
    // Public, also baked into the app at build time from VITE_POOL_ADDRESS.
    "POOL_ADDRESS": "0xa592d4392b0784502ce40747ee402744c8300e6b"
  },
  // RELAYER_PRIVATE_KEY is a secret: `bunx wrangler secret put RELAYER_PRIVATE_KEY`
  "env": {
    // Arc mainnet: a separate Worker, deployed with `bun run cf:deploy:mainnet` (builds with .env.mainnet).
    // Its relayer key is its own secret: `bunx wrangler secret put RELAYER_PRIVATE_KEY --env mainnet`
    "mainnet": {
      "name": "zerith-mainnet",
      "durable_objects": {
        "bindings": [{ "name": "RELAYER", "class_name": "Relayer" }]
      },
      "vars": {
        "CHAIN_ID": "5042",
        "POOL_ADDRESS": "0x322528dcd9f204d381f411c2815f3f4e63440782"
      }
    }
  }
}
